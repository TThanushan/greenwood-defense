# Standard Unity Ignore (Already included)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Aa]ssets/AddressableAssetsData/*/*.bin*
[Aa]ssets/StreamingAssets/aa.meta
[Aa]ssets/StreamingAssets/aa/

# 🛑 EXCLUDE UNNECESSARY HEAVY ASSETS
[Aa]ssets/RawAssets/         # Ignore unprocessed raw assets
[Aa]ssets/Sprites/HighRes/   # High-resolution sprite sources
[Aa]ssets/Music/             # Music files (if large)
[Aa]ssets/Video/             # Videos (if any)
[Aa]ssets/UnprocessedAssets/ # Placeholder for large unoptimized files

# 🛑 IGNORE AUTO-GENERATED FILES
[Aa]ssets/**/*.psd           # Photoshop files (keep only final PNGs)
[Aa]ssets/**/*.blend         # Blender files (exclude source models)
[Aa]ssets/**/*.fbx           # 3D models (exclude if unnecessary)
[Aa]ssets/**/*.wav           # Large sound files (keep only compressed)
[Aa]ssets/**/*.mp4           # Large videos

# 🛑 IGNORE UNITY-RELATED CACHE
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt

# 📦 IGNORE BUILD FILES
*.apk
*.aab
*.unitypackage
*.app

# 📦 IGNORE DEBUG FILES
crashlytics-build.properties
